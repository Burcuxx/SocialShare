# Copy to .env and fill in. Never commit .env.

# Google Cloud OAuth client (YouTube Data API v3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok for Developers app (Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Meta app (Instagram Graph API)
META_APP_ID=
META_APP_SECRET=

# Base URL the OAuth callbacks redirect to
APP_URL=http://localhost:3000

# Local paths (defaults shown)
DATABASE_PATH=./data/social-share.db
TMP_DIR=./tmp
